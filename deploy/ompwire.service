[Unit]
# NOT ACTIVE YET: `ompwire serve` (Telegram transport) is not implemented.
# Enable this unit only after that subcommand lands.
Description=ompwire — OMP agent over ACP for chat platforms
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ompwire
EnvironmentFile=%h/ompwire/.env
ExecStart=%h/ompwire/.venv/bin/ompwire serve
Restart=on-failure
RestartSec=5
# One ACP subprocess per conversation plus the poller; keep the cgroup honest.
MemoryMax=4G

[Install]
WantedBy=default.target
