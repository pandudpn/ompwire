# Secrets for ompwire. Copy to .env (chmod 600) — never commit.
# ompwire loads these itself; systemd units can use EnvironmentFile=.

# Telegram bot token from @BotFather.
# Use a dedicated bot: two processes polling the same token fight over updates.
TELEGRAM_BOT_TOKEN=

# Optional overrides of config.toml
# OMPWIRE_ACP_COMMAND=omp
# OMPWIRE_ACP_ARGS=--mode rpc-ui
# OMPWIRE_CWD=/home/you
# OMPWIRE_MODEL=omniroute/chat
# OMPWIRE_MODE=default
# OMPWIRE_IDLE_TIMEOUT=1800
