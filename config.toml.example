# ompwire configuration
#
# Transport settings only. ompwire does not own memory, skills, tools or the
# agent loop — the OMP agent does. Secrets (bot token) come from the environment,
# see .env.example. Any key here can also be set with an OMPWIRE_* env var;
# run `ompwire config` to see the merged result.

[acp]
# ACP agent to spawn. `--mode acp` is what turns omp into a protocol agent; it is
# not listed in `omp --help`, so pin the omp version you tested against.
command = "omp"
args = ["--mode", "acp"]
startup_timeout = 60.0     # seconds for initialize / session new-or-load
turn_timeout = 900.0       # seconds for one prompt turn

[agent]
cwd = "~"                  # working directory handed to the agent
model = ""                 # empty = whatever the ACP session defaults to
mode = ""                  # "" | "default" | "plan"
approval_mode = "always-ask"       # forwarded to the agent as --approval-mode
permission_policy = "ask"          # allow | deny | ask (Telegram shows buttons)

[session]
store = "~/.local/state/ompwire/sessions.db"
idle_timeout = 1800        # drop the ACP subprocess after this many idle seconds

[stream]
enabled = true
edit_interval = 1.0        # seconds between message edits (Telegram edit-in-place)
show_tool_calls = true
show_usage = true

[[mcp.servers]]
# Tools the agent should have for the whole session, passed straight through to
# session/new. Anything the agent needs — memory, database, issue tracker — is an
# MCP server here, not code in this repo.
name = "context7"
command = "npx"
args = ["-y", "@upstash/context7-mcp"]

[telegram]
bot_token = ""             # secret: set TELEGRAM_BOT_TOKEN instead
allowed_users = []         # numeric Telegram user ids; empty = nobody can talk to it
home_channel = ""
