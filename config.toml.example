# ompwire configuration
#
# Transport settings only. ompwire does not own memory, skills, tools, MCP servers or the
# agent loop — the OMP agent does. Secrets (bot tokens) live in each gateway's own .env.
# Any key here can also be set with an OMPWIRE_* env var; run `ompwire config` to see the
# merged result.

[acp]
# The agent process. omp runs in RPC-UI mode; the section keeps its old name so existing
# configs load, and an `--mode acp` or `--mode rpc` left in one is read as `--mode rpc-ui`.
command = "omp"
args = ["--mode", "rpc-ui"]
startup_timeout = 60.0     # seconds for the agent to report ready
turn_timeout = 900.0       # seconds of silence before a turn is given up

[agent]
cwd = "~"                  # working directory handed to the agent
model = ""                 # provider/id, e.g. "omniroute/chat"; empty = omp's default
mode = "default"           # default | plan
thinking = "xhigh"         # off | minimal | low | medium | high | xhigh
approval_mode = "write"    # forwarded to the agent as --approval-mode
# Who the agent is. SOUL.md beside the session store (state/gateways/<name>/SOUL.md, or
# state/cli/SOUL.md for `ompwire chat`) wins over this; `ompwire gateway start` offers to draft it.
persona = ""
# omp does not know it is answering inside a chat window, and on its own it writes
# commands inline. This hint is what makes replies render as code blocks. It always follows
# the persona. Set to "" to send only the persona and the file/options marker protocol.
chat_format_hint = """You are answering inside a chat window. Format every reply as markdown: put shell commands, file paths, diffs and multi-line output inside fenced code blocks with a language tag, use short paragraphs and bullets, and never paste raw tables where a short list reads better. Keep prose tight."""

[approval]
# ask   = approval buttons in chat (waits [approval].timeout, then denies)
# allow = auto-approve every tool call
# deny  = auto-reject every tool call
policy = "ask"
timeout = 120.0

[files]
max_mb = 20.0             # per file, both directions; a bigger one is refused with a note in chat
incoming_dir = "~/.local/state/ompwire/files"   # documents sent into the chat land here for the agent

[logging]
level = "INFO"
file = "~/.local/state/ompwire/ompwire.log"   # empty = stderr only

[session]
store = "~/.local/state/ompwire/sessions.db"
idle_timeout = 1800        # stop a chat's agent process after this many idle seconds

[stream]
enabled = true
show_tool_calls = true
show_usage = false       # per-turn token line; use /usage instead
min_gap = 1.0              # seconds between messages; Telegram allows about one a second per chat
compaction_warn = 0.6     # fraction of the context window that triggers one ⚠️ notice per crossing

# MCP servers are omp's: list them in ~/.omp/agent/mcp.json (`ompwire setup` can add one).
# The agent loads them itself, so a hub there starts only the servers a turn calls.
